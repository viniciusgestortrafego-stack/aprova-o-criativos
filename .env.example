# Token de System User da BM com permissão ads_read. Nunca usar prefixo NEXT_PUBLIC_.
META_ACCESS_TOKEN=
# ID da BM da agência (não é segredo). As contas do painel vêm daqui.
META_BUSINESS_ID=
# 32 bytes aleatórios. Assina os links dos clientes. Trocar derruba todos os links.
LINK_SECRET=
# Senha do painel interno (usuário pode ser qualquer um).
ADMIN_PASSWORD=
# Postgres do Neon (a integração da Vercel cria). Sem aspas ao colar aqui.
DATABASE_URL=
# Chave de API do Google restrita à Drive API. Só lê pasta "Qualquer pessoa com o link".
GOOGLE_API_KEY=
